NODE_ENV=production
PORT=3001
CLIENT_ORIGIN=https://chat.oranges.lt
OAUTH_REDIRECT_BASE=https://chat.oranges.lt

DATABASE_URL=postgresql://orangchat:CHANGE_ME@localhost:5432/orangchat?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional Google reCAPTCHA v2 checkbox. Set both to enable it; rate limits
# remain active when they are blank.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Required for email verification and email login codes.
RESEND_API_KEY=
EMAIL_FROM=OrangChat <noreply@oranges.lt>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Push notifications. Keep the private VAPID key and Firebase service-account
# JSON outside source control. FCM_SERVICE_ACCOUNT accepts either a JSON file
# path or the JSON value itself.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@oranges.lt
FCM_SERVICE_ACCOUNT=/etc/orangchat/firebase-service-account.json

# Blob storage for avatars, banners, and attachments under 10MB. All three must
# be set; with any missing, uploads fall back to the local dirs below. Attachments
# over 10MB keep going to OrangMove either way.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Required with Cloudinary. Generate once with: openssl rand -base64 32
# Keep the value permanently: changing it makes existing attachments unreadable.
ATTACHMENT_ENCRYPTION_KEY=

# Where avatars/banners and message attachments are written when Cloudinary is
# unset. Both must sit under the service's ReadWritePaths (/var/lib/orangchat);
# nginx serves them, under different rules - see deploy/nginx/chat.oranges.lt.conf.
# Keep these pointed at the existing dirs even after switching to Cloudinary:
# rows written before the switch still have /uploads/ and /attachments/ urls.
UPLOAD_DIR=/var/lib/orangchat/uploads
ATTACHMENT_DIR=/var/lib/orangchat/attachments

# OrangMove's file API, used to verify an upload token before an attachment over
# 10MB is recorded. Loopback on purpose: it shouldn't depend on DNS or TLS, and
# the token is a bearer secret best kept off the public internet.
ORANGMOVE_API_URL=http://127.0.0.1:8080/api
