[Unit]
Description=LiveKit realtime media server for OrangChat
Requires=docker.service
After=docker.service network-online.target redis-server.service coturn.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f orangchat-livekit
ExecStart=/usr/bin/docker run --rm --name orangchat-livekit --network host --volume /etc/livekit/livekit.yaml:/etc/livekit.yaml:ro livekit/livekit-server:v1.13.1 --config /etc/livekit.yaml
ExecStop=/usr/bin/docker stop --time 30 orangchat-livekit
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
