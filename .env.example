# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Public origin of the client (for CORS + OAuth redirects)
CLIENT_ORIGIN=http://localhost:5173

# ── Database (matches docker-compose.yml host ports) ─────
DATABASE_URL=postgresql://orangchat:orangchat@localhost:5433/orangchat?schema=public
REDIS_URL=redis://localhost:6380

# ── Auth ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── OAuth (fill in before Phase 1 completes) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3001

# ── Voice (Phase 5, LiveKit) ────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
