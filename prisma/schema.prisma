generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  passwordHash         String?
  username             String   @unique
  displayName          String
  avatarUrl            String?
  status               String   @default("offline")
  bio                  String?
  bannerUrl            String?
  accentColor          Int?
  pronouns             String?
  customCss            String?
  profileCss           String?
  /// Replaces the OrangChat mark on this user's own clients (favicon, in-app
  /// branding, Electron window/tray icon). Self-only - never on the public DTO.
  appIconUrl           String?
  dmPrivacy            String   @default("everyone") // "everyone" | "friends" | "none"
  friendRequestPrivacy String   @default("everyone") // "everyone" | "mutual" | "none"
  typingIndicators     Boolean  @default(true)
  /// Which friend events raise a notification. Coming-online is opt-in: it
  /// fires for every friend on every app launch.
  notifyFriendRequests Boolean  @default(true)
  notifyFriendAccepted Boolean  @default(true)
  notifyFriendOnline   Boolean  @default(false)
  /// "Require verification before messaging anyone new" (docs/E2EE.md §6.5).
  /// A per-user policy that only ever blocks this account's own sending; it
  /// never mutates anybody else's settings.
  e2eeStrict           Boolean  @default(false)
  /// "Display the game you're playing". Off by default: detecting a game means
  /// the desktop client reading the process list, which must be a choice rather
  /// than something that starts happening because an update shipped.
  gameActivity         Boolean  @default(false)
  totpSecret           String? // base32 secret
  totpEnabled          Boolean  @default(false)
  emailVerifiedAt      DateTime?
  emailVerifications   EmailVerification[]
  emailLoginCodes      EmailLoginCode[]
  /// Awarded profile badges, as catalog slugs (see services::badge). Denormalized
  /// onto the user so every `SELECT * FROM "User"` already carries them.
  badges               String[] @default([])
  /// Set while the account is in lockdown: no new sign-ins, no new DMs, no
  /// friend requests. Lifted by the owner from a session that survived it.
  lockdownAt           DateTime?
  /// A bot account. Bots are User rows rather than their own table because
  /// authorship, membership, roles and permissions all key on User - a separate
  /// table would need a parallel nullable column on every one of them. A bot has
  /// no password, an undeliverable synthetic email, and `emailVerifiedAt` set at
  /// creation (the auth extractor rejects unverified accounts outright).
  isBot                Boolean  @default(false)
  /// The human who created this bot, on bot rows only. Deleting the owner takes
  /// their bots with them - an ownerless bot answers to nobody.
  ownerId              String?
  owner                User?    @relation("BotOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  bots                 User[]   @relation("BotOwner")
  botTokens            BotToken[]
  /// Set when the account is deleted. The row is kept as a tombstone so the
  /// user's messages stay readable in other people's conversations; everything
  /// identifying was scrubbed at deletion. See services::account.
  deletedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  totpBackupCodes        TotpBackupCode[]
  oauthAccounts          OAuthAccount[]
  ownedServers           Server[]             @relation("ServerOwner")
  memberships            ServerMember[]
  messages               Message[]
  reactions              Reaction[]
  channelParticipants    ChannelParticipant[]
  sentInvites            Invite[]             @relation("InviteInviter")
  bans                   Ban[]                @relation("BannedUser")
  sentFriendRequests     Friendship[]         @relation("FriendRequester")
  receivedFriendRequests Friendship[]         @relation("FriendAddressee")
  readStates             ReadState[]
  drafts                 Draft[]
  connections            Connection[]
  pendingAttachments     PendingAttachment[]
  pushSubscriptions      PushSubscription[]
  auditLogEntries        AuditLog[]           @relation("AuditLogActor")
  createdEmojis          Emoji[]              @relation("EmojiCreator")
  createdSounds          Sound[]              @relation("SoundCreator")
  createdEvents          ScheduledEvent[]     @relation("EventCreator")
  eventInterests         EventInterest[]
  devices                Device[]
  deviceLog              DeviceLogEntry[]
  keyDeletionRequests    KeyDeletionRequest[]
  messageReports         MessageReport[]
  passkeys               Passkey[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model EmailLoginCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  loginTokenHash String @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model PushSubscription {
  id     String @id @default(cuid())
  userId String
  kind   String
  endpoint String  @unique
  p256dh   String?
  auth     String?
  label String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

/// A bot's API credential. Stored as a SHA-256 hex digest, never in the clear -
/// the plaintext is shown once at mint and cannot be recovered afterwards.
///
/// Deliberately not argon2 (which every other secret here uses): the token is 32
/// bytes of CSPRNG output rather than a human password, so it is not guessable
/// and needs no slow KDF - and argon2 at the configured 19 MiB would run on
/// every single bot API call. The digest exists so a database leak does not hand
/// over live credentials.
model BotToken {
  id        String    @id @default(cuid())
  botId     String
  tokenHash String    @unique
  /// Shown in the developer panel so an owner can tell two tokens apart without
  /// revealing either: the token's last four characters.
  hint      String
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?
  bot User @relation(fields: [botId], references: [id], onDelete: Cascade)
  @@index([botId])
}

model Connection {
  id         String  @id @default(cuid())
  userId     String
  provider   String
  providerId String
  name       String
  profileUrl String?
  verified   Boolean @default(false)
  visible    Boolean @default(true)
  position   Int     @default(0)
  oauthAccessToken  String?
  oauthRefreshToken String?
  oauthExpiresAt    DateTime?
  oauthScope        String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider, providerId])
  @@index([userId])
}

/// A WebAuthn credential. The private half never leaves the authenticator, so
/// what is stored here proves nothing on its own - it only verifies signatures.
///
/// A passkey outranks TOTP as a second factor and can stand in for the whole
/// login: the authenticator has already checked the user (biometric or PIN) and
/// is bound to this origin, which is more than a password plus a code that can
/// be read aloud over the phone. See services::passkey.
model Passkey {
  id           String   @id @default(cuid())
  userId       String
  /// The authenticator's credential id, base64url. Unique across all accounts:
  /// a discoverable credential is looked up by this alone, before any user is
  /// known, so a collision would be an ambiguous sign-in.
  credentialId String   @unique
  /// webauthn-rs's serialised `Passkey`, holding the public key, signature
  /// counter and transport hints. Opaque here on purpose - the shape belongs to
  /// the library, and parsing it in SQL would pin us to its version.
  credential   Json
  /// What the user calls it ("Phone", "YubiKey"). Named at registration from
  /// the authenticator's own AAGUID where we recognise it, renameable after.
  name         String
  /// True when the authenticator says the key is synced to a cloud keychain.
  /// Worth surfacing: a synced key survives a lost phone, a device-bound one
  /// does not, and that changes whether it is safe to be someone's only one.
  backedUp     Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model TotpBackupCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("pending") // "pending" | "accepted"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model OAuthAccount {
  id         String   @id @default(cuid())
  provider   String // "google"
  providerId String
  userId     String
  createdAt  DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerId])
  @@index([userId])
}

model Server {
  id          String  @id @default(cuid())
  name        String
  iconUrl     String?
  description String?
  bannerUrl   String?
  ownerId     String
  systemChannelId String?
  afkChannelId    String?
  afkTimeout      Int     @default(300)
  defaultMessageNotifications String @default("all")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User           @relation("ServerOwner", fields: [ownerId], references: [id])
  members   ServerMember[]
  roles     Role[]
  channels  Channel[]
  invites   Invite[]
  bans      Ban[]
  auditLogs AuditLog[]
  emojis    Emoji[]
  sounds    Sound[]
  events    ScheduledEvent[]
  @@index([ownerId])
}

/// A soundboard clip, playable by anyone in server's voice channels.

model Sound {
  id        String   @id @default(cuid())
  serverId  String
  name      String
  url       String
  duration  Float
  emoji     String?
  volume    Float    @default(1)
  creatorId String?
  createdAt DateTime @default(now())
  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User?  @relation("SoundCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  @@unique([serverId, name])
  @@index([serverId])
}

model ScheduledEvent {
  id          String    @id @default(cuid())
  serverId    String
  channelId   String?
  creatorId   String?
  name        String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  server    Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channel   Channel?        @relation(fields: [channelId], references: [id], onDelete: SetNull)
  creator   User?           @relation("EventCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  interests EventInterest[]
  @@index([serverId, startsAt])
}

model EventInterest {
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event ScheduledEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([eventId, userId])
  @@index([userId])
}

model Emoji {
  id        String   @id @default(cuid())
  serverId  String
  name      String
  url       String
  animated  Boolean  @default(false)
  creatorId String?
  createdAt DateTime @default(now())
  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User?  @relation("EmojiCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  @@unique([serverId, name])
  @@index([serverId])
}

model AuditLog {
  id         String  @id @default(cuid())
  serverId   String
  actorId    String?
  /// e.g. "role.create", "channel.update", "member.kick"
  action     String
  targetId   String?
  targetType String?
  /// Shape: { "field": { "old": …, "new": … } }
  changes    Json    @default("{}")
  reason     String?
  createdAt DateTime @default(now())
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([serverId, createdAt])
  @@index([actorId])
}

model Ban {
  id         String   @id @default(cuid())
  serverId   String
  userId     String
  bannedById String
  reason     String?
  createdAt  DateTime @default(now())
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  @@unique([serverId, userId])
  @@index([userId])
}

model ServerMember {
  id       String   @id @default(cuid())
  serverId String
  userId   String
  nickname String?
  timedOutUntil DateTime?
  joinedAt DateTime @default(now())
  server      Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberRoles MemberRole[]
  @@unique([serverId, userId])
  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  serverId    String
  name        String
  color       Int      @default(0)
  permissions BigInt   @default(0)
  position    Int      @default(0)
  hoist       Boolean  @default(false)
  mentionable Boolean  @default(false)
  createdAt   DateTime @default(now())
  server      Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  memberRoles MemberRole[]
  @@index([serverId])
}

model MemberRole {
  id       String @id @default(cuid())
  memberId String
  roleId   String
  member ServerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([memberId, roleId])
  @@index([roleId])
}

model Channel {
  id               String   @id @default(cuid())
  serverId         String? // null for dm / group
  name             String?
  type             String // "text" "voice" "category" "dm" "group_dm"
  topic            String?
  /// Shared DM chat background, set by any participant (Messenger-style).
  /// Plaintext like avatars, never E2EE like attachments: the server must be
  /// able to hand the same image to every participant and to new ones joining
  /// later, which encrypted per-recipient payloads could not do.
  backgroundUrl    String?
  /// Group DM icon, set by any participant. Plaintext like an avatar, for the
  /// same reason as backgroundUrl: everyone in the group, including people who
  /// join later, has to be handed the same picture.
  iconUrl          String?
  position         Int      @default(0)
  parentCategoryId String?
  nsfw             Boolean  @default(false)
  rateLimitPerUser Int      @default(0)
  userLimit        Int      @default(0)
  bitrate          Int      @default(64000)
  e2ee             Boolean  @default(false)
  epochNumber      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  server         Server?              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  parentCategory Channel?             @relation("ChannelCategory", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children       Channel[]            @relation("ChannelCategory")
  messages       Message[]
  participants   ChannelParticipant[]
  overwrites     ChannelOverwrite[]
  readStates     ReadState[]
  events         ScheduledEvent[]
  drafts         Draft[]
  epochs         ChannelEpoch[]
  @@index([serverId])
  @@index([parentCategoryId])
}

model Draft {
  userId    String
  channelId String
  content   String
  updatedAt DateTime @updatedAt
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  @@id([userId, channelId])
  @@index([userId])
}

model ChannelOverwrite {
  id        String @id @default(cuid())
  channelId String
  type      String
  targetId  String
  allow     BigInt @default(0)
  deny      BigInt @default(0)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  @@unique([channelId, type, targetId])
  @@index([channelId])
}

model ChannelParticipant {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())
  /// When this user closed a one-to-one DM. Membership is kept so the history
  /// and delivery survive; the conversation is simply not listed until a new
  /// message arrives, which clears this. Group DMs delete the row instead.
  hiddenAt  DateTime?
  /// This user's "verify before messaging" rule for this conversation; null
  /// follows their global `e2eeStrict`. The rule is enforced on their own
  /// device - the server holds it so that turning it on or off is an action
  /// the server carried out, and can therefore announce as a system notice
  /// the other side can trust. No key material is involved either way.
  e2eeStrict Boolean?
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id          String    @id @default(cuid())
  channelId   String
  authorId    String
  content     String
  /// Set only by the server, and only from an action it carried out itself:
  /// "strictEnabled" | "strictDisabled" | "keyReset" | "backgroundChanged" |
  /// "backgroundRemoved". Clients draw any message carrying one as a notice
  /// about the conversation rather than as a line its author typed. Never
  /// accepted on a client's send - that is the whole point of the column,
  /// because recognising a notice by its text let anyone forge one by typing
  /// the sentence. `authorId` stays the person whose action it was, so a
  /// notice can still say who did it.
  systemNotice String?
  /// Whatever the notice needs beyond its own name, for the kinds that are a
  /// live card rather than one sentence. A "call" carries who is on it, when it
  /// started, and - once it is over - how long it lasted, and the server edits
  /// this row as the call progresses. Plaintext, like `systemNotice`: it is
  /// metadata the server already has, never anything a person typed.
  systemData  Json?
  ciphertext  Bytes?
  encEpoch    Int?
  encVersion  Int?
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  replyToId   String?
  attachments Json      @default("[]")
  pinned      Boolean   @default(false)
  pinnedAt    DateTime?
  /// Stored generated tsvector backing server-channel search. Declared only so
  /// Prisma sees no drift - it is maintained by Postgres, never written here,
  /// and `migrate dev` would recreate it as a plain column. Its real definition
  /// lives in 20260730120000_message_search_fts.
  searchVector Unsupported("tsvector")?
  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo   Message?   @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]  @relation("MessageReply")
  reactions Reaction[]
  @@index([channelId, createdAt])
  @@index([authorId])
}

/// A recipient-created abuse report. For E2EE messages `plaintext` is accepted
/// only after the server opens the original ciphertext with a deliberately
/// disclosed one-message key and verifies the sender-device signature.
model MessageReport {
  id             String   @id @default(cuid())
  messageId      String
  channelId      String
  reporterId     String
  authorId       String
  reason         String?
  plaintext      String
  encrypted      Boolean  @default(false)
  ciphertext     Bytes?
  encEpoch       Int?
  senderDeviceId String?
  signature      Bytes?
  createdAt      DateTime @default(now())
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  @@unique([reporterId, messageId])
  @@index([channelId, createdAt])
  @@index([authorId, createdAt])
}

model PendingAttachment {
  id           String    @id @default(cuid())
  uploaderId   String
  url          String
  filename     String
  contentType  String
  size         Int
  width        Int?
  height       Int?
  /// Seconds, for audio and video. Captured by the sender's client at upload.
  duration     Float?
  /// Still image (first frame) for video, so receivers preview without the file.
  thumbnailUrl String?
  storage      String
  flagged      Boolean   @default(false)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  @@index([uploaderId])
  @@index([createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([messageId, userId, emoji])
  @@index([userId])
}

model ReadState {
  userId            String
  channelId         String
  lastReadMessageId String?
  mentionCount      Int      @default(0)
  updatedAt         DateTime @updatedAt
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  @@id([userId, channelId])
  @@index([channelId])
}

model Device {
  id               String    @id @default(cuid())
  userId           String
  name             String
  platform         String // "web" | "android" | "desktop"
  ikSigPub         Bytes
  ikDhPub          Bytes
  bundleSig        Bytes
  authorizedBy     String?
  authorizationSig Bytes?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  revokedAt        DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyEnvelopes KeyEnvelope[]
  @@index([userId])
}

/// A standing request to wipe an account's encryption identity, for the one case
/// the protocol cannot solve: every device holding the key is gone, so no
/// signature that could revoke them exists. Deliberately slow and loud - the
/// same request from somebody who stole the password ends with the real owner
/// reading about it while there is still time to stop it.
model KeyDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  requestedAt DateTime  @default(now())
  /// Not before this instant, and only if no keyed device checked in meanwhile.
  executeAfter DateTime
  /// SHA-256 of the cancel token; the raw value only ever exists in the email.
  cancelTokenHash String @unique
  requestedIp String?
  cancelledAt DateTime?
  /// Set when a device holding the key checked in during the wait, which is the
  /// account answering for itself: somebody still has it, so nothing is wiped.
  abortedAt   DateTime?
  executedAt  DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([executeAfter])
}

model DeviceLogEntry {
  id        String   @id @default(cuid())
  userId    String
  seq       Int
  kind      String // "genesis" | "add-device" | "revoke"
  payload   Bytes
  entryHash Bytes
  prevHash  Bytes?
  signature Bytes
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, seq])
  @@index([userId])
}

model ChannelEpoch {
  id        String   @id @default(cuid())
  channelId String
  epoch     Int
  createdAt DateTime @default(now())
  createdBy String
  channel   Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  envelopes KeyEnvelope[]
  @@unique([channelId, epoch])
}

model KeyEnvelope {
  id           String @id @default(cuid())
  epochId      String
  deviceId     String
  ephemeralPub Bytes
  wrapNonce    Bytes
  wrapped      Bytes
  epoch  ChannelEpoch @relation(fields: [epochId], references: [id], onDelete: Cascade)
  device Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@unique([epochId, deviceId])
  @@index([deviceId])
}

model Invite {
  code      String    @id
  serverId  String
  inviterId String
  expiresAt DateTime?
  maxUses   Int?
  uses      Int       @default(0)
  createdAt DateTime  @default(now())
  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  inviter User   @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  @@index([serverId])
  @@index([inviterId])
}
