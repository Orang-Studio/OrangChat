# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ── Database (dev docker: postgres :5433) ───────────────
DATABASE_URL=postgresql://orangchat:orangchat@localhost:5433/orangchat
REDIS_URL=redis://localhost:6380

# ── Auth (generate with: openssl rand -hex 32) ──────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── OAuth login (optional) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3001

# ── Profile connections (all optional) ──────────────────
# Linkable accounts shown on a user's profile. A provider with no credentials
# is simply not offered in the UI, so fill in only the ones you want.
# Each app's callback URL is:  $OAUTH_REDIRECT_BASE/api/connections/<key>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# YouTube may reuse the GOOGLE_* values above, but set them here explicitly and
# only after that Google app has BOTH the YouTube Data API enabled AND
# $OAUTH_REDIRECT_BASE/api/connections/youtube/callback listed as an authorized
# redirect URI — otherwise linking dies at consent with redirect_uri_mismatch.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Steam uses OpenID and needs no app. The Web API key is optional: without it a
# linked account shows its numeric id instead of the persona name.
STEAM_API_KEY=

# ── Voice (optional, LiveKit) ───────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Blob storage (optional, Cloudinary) ─────────────────
# Holds avatars, banners, and attachments under 20MB. All three must be set or
# uploads fall back to local disk (UPLOAD_DIR / ATTACHMENT_DIR). The cloud name
# is on the Cloudinary dashboard; the secret is a ~27-char alphanumeric string,
# never numeric — if it looks like the key, it's the key.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Image moderation (optional, OpenAI) ─────────────────
# Runs uploaded images through omni-moderation-latest. Flagged images are stored
# and attached as normal, but clients render a placeholder instead of the pixels.
# Unset means no image is ever checked or flagged. Fails open on any API error.
OPENAI_API_KEY=
